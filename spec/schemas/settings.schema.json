        {
          "type": "object",
          "required": [
            "mode",
            "quaternions_xyzw"
          ],
          "properties": {
            "mode": {
              "const": "custom"
            },
            "quaternions_xyzw": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/q"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "search": {
      "type": "object",
      "required": [
        "preset",
        "seed",
        "deterministic"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
