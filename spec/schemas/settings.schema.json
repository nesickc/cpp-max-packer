            "backend": {
              "enum": [
                "cpu",
                "vulkan"
              ]
            },
            "thread_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "cpu_runtime": {
              "type": "object",
              "required": [
                "version",
                "scheduling_policy"
