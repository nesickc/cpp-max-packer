        "seed": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/seed"
        },
        "deterministic": {
          "type": "boolean"
        },
        "budget_seconds": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/positive"
        },
        "work_budget": {
          "type": "object",
          "required": [
            "max_candidate_evaluations",
            "max_search_passes"
          ],
          "properties": {
            "max_candidate_evaluations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_search_passes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "budget_scope": {
          "enum": [
            "search_only",
            "total_start"
          ]
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "longest_object_axis_cells"
          ],
          "properties": {
            "mode": {
              "const": "auto"
            },
            "longest_object_axis_cells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "pitch_mm"
          ],
          "properties": {
            "mode": {
              "const": "manual"
            },
            "pitch_mm": {
              "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/positive"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "compute": {
      "type": "object",
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "enum": [
            "auto",
            "cpu",
            "vulkan"
          ]
        },
        "thread_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "host_memory_limit_bytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      },
      "additionalProperties": false
    },
    "requested": {
      "type": "object",
