{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spectrapack.invalid/schemas/v1/settings.schema.json",
  "definitions": {
    "q": {
      "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/quaternion"
    },
    "box": {
      "type": "object",
      "required": [
        "kind",
        "dimensions_mm"
      ],
      "properties": {
        "kind": {
          "const": "box"
        },
        "dimensions_mm": {
          "type": "array",
          "items": {
            "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/positive"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "tolerance_mm": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/nonnegative",
          "description": "Allowed oversize of the box: each validated interior dimension is dimensions_mm + tolerance_mm. Absent means 0."
        }
      },
      "additionalProperties": false
    },
    "stl_id": {
      "type": "object",
      "required": [
        "kind",
        "asset_id"
      ],
      "properties": {
        "kind": {
          "const": "stl_volume"
        },
        "asset_id": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/runtime_id"
        }
      },
      "additionalProperties": false
    },
    "stl_ref": {
      "type": "object",
      "required": [
        "kind",
        "asset"
      ],
      "properties": {
        "kind": {
          "const": "stl_volume"
        },
        "asset": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/content_ref"
        }
      },
      "additionalProperties": false
    },
    "or_requested": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "quaternion_xyzw": {
              "$ref": "#/definitions/q"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "upright",
                "cube"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "catalog_size"
          ],
          "properties": {
            "mode": {
              "const": "free"
            },
            "catalog_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "quaternions_xyzw"
          ],
          "properties": {
            "mode": {
              "const": "custom"
            },
            "quaternions_xyzw": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/q"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "or_resolved": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "quaternion_xyzw"
          ],
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "quaternion_xyzw": {
              "$ref": "#/definitions/q"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "upright",
                "cube"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "catalog_size"
          ],
          "properties": {
            "mode": {
              "const": "free"
            },
            "catalog_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
