{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spectrapack.invalid/schemas/v1/benchmark-summary.schema.json",
  "definitions": {
    "counter": {
      "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/counter"
    },
    "timings": {
      "type": "object",
      "required": [
        "preprocessing_seconds",
        "search_seconds",
        "validation_seconds",
        "export_seconds",
        "cold_end_to_end_seconds"
      ],
      "properties": {
        "preprocessing_seconds": {
          "type": "number",
          "minimum": 0
        },
        "search_seconds": {
          "type": "number",
          "minimum": 0
        },
        "validation_seconds": {
          "type": "number",
          "minimum": 0
        },
        "export_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cold_end_to_end_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "segment_id",
        "from",
        "to",
        "reason",
        "elapsed_seconds"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "enum": [
            "cpu",
            "vulkan"
          ]
        },
        "to": {
          "enum": [
            "cpu",
            "vulkan"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "device": {
          "type": "string"
        },
        "driver": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/portable_path"
        },
        "sha256": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/sha256"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "seed",
        "status",
        "settings",
        "count",
        "result",
        "validation_failures",
        "timings",
        "peak_host_bytes",
        "peak_device_bytes",
        "improvements",
        "backend_transitions"
      ],
      "properties": {
        "seed": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/seed"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "settings": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://spectrapack.invalid/schemas/v1/settings.schema.json#/definitions/resolved"
            }
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/counter"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/result"
            }
          ]
        },
        "validation_failures": {
          "$ref": "#/definitions/counter"
        },
        "timings": {
          "$ref": "#/definitions/timings"
        },
        "peak_host_bytes": {
          "$ref": "#/definitions/counter"
        },
        "peak_device_bytes": {
          "$ref": "#/definitions/counter"
        },
        "improvements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "count",
              "elapsed_seconds"
            ],
            "properties": {
              "count": {
                "$ref": "#/definitions/counter"
              },
              "elapsed_seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "backend_transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/transition"
          }
        },
        "error": {
          "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/error"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "settings",
              "count",
              "result"
            ],
            "properties": {
              "settings": {
                "$ref": "https://spectrapack.invalid/schemas/v1/settings.schema.json#/definitions/resolved"
              },
              "count": {
                "$ref": "#/definitions/counter"
              },
              "result": {
                "$ref": "#/definitions/result"
              },
              "validation_failures": {
                "const": 0
              },
              "error": {
                "not": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "created_at",
    "engine",
    "host",
    "dependency_revisions",
    "configuration",
    "runs",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "https://spectrapack.invalid/schemas/v1/common.schema.json#/definitions/timestamp"
    },
    "engine": {
      "type": "object",
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "required": [
        "cpu",
        "gpu",
        "driver",
        "os_build",
        "thread_count"
      ],
      "properties": {
        "cpu": {
          "type": "string"
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "os_build": {
          "type": "string"
        },
        "thread_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "dependency_revisions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "method",
        "settings",
        "cache_state"
      ],
      "properties": {
        "method": {
          "enum": [
            "aabb",
            "greedy_spectral",
            "full_search"
          ]
        },
        "settings": {
          "$ref": "https://spectrapack.invalid/schemas/v1/settings.schema.json#/definitions/resolved"
        },
        "cache_state": {
          "enum": [
            "cold",
            "warm"
          ]
        }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/run"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "successful_runs",
        "failed_runs",
        "best_count",
        "median_count",
        "worst_count"
      ],
      "properties": {
        "successful_runs": {
          "$ref": "#/definitions/counter"
        },
        "failed_runs": {
          "$ref": "#/definitions/counter"
        },
        "best_count": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/counter"
            }
          ]
        },
        "median_count": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "worst_count": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/counter"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
