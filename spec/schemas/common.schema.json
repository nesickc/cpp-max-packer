{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spectrapack.invalid/schemas/v1/common.schema.json",
  "definitions": {
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "matrix4": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^[A-Za-z]:|^/|^\\\\|\\\\|(^|/)\\.{1,2}(/|$)|\\x00)"
      }
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00]+$"
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "clearance": {
      "type": "object",
      "required": [
        "pair",
        "wall"
      ],
      "properties": {
        "pair": {
          "$ref": "#/definitions/nonnegative"
        },
        "wall": {
          "$ref": "#/definitions/nonnegative"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        },
        "recoverable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "content_ref": {
      "type": "object",
      "required": [
        "source_sha256",
        "accepted_solid_sha256"
      ],
      "properties": {
        "source_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "accepted_solid_sha256": {
          "$ref": "#/definitions/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
